{
  "entities": {
    "PromptPost": {
      "title": "PromptPost",
      "description": "AI prompt cards displayed on the website and directory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "aiTool": { "type": "string", "maxLength": 50 },
        "promptText": { "type": "string", "maxLength": 50000 },
        "negativePrompt": { "type": "string", "maxLength": 5000 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "imageAlt": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "isFeatured": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "isPremium": { "type": "boolean" },
        "viewsCount": { "type": "number" },
        "copiesCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "promptText", "category"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user accounts, subscriptions, and usage credits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 100 },
        "planTier": { "type": "string", "enum": ["free", "starter", "pro", "vip", "ultra"] },
        "isProUser": { "type": "boolean" },
        "toolCredits": { "type": "number" },
        "aiSearchRemaining": { "type": "number" },
        "points": { "type": "number" },
        "joinedDate": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Category": {
      "title": "Category",
      "description": "Prompt categories taxonomy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "count": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "SearchQuery": {
      "title": "SearchQuery",
      "description": "User search query history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "query": { "type": "string", "maxLength": 200 },
        "count": { "type": "number" },
        "lastSearched": { "type": "number" }
      },
      "required": ["id", "query", "count"]
    },
    "PromptRequest": {
      "title": "PromptRequest",
      "description": "Custom prompt requests submitted by users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "requestText": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "rejected"] },
        "fulfilledPrompt": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userEmail", "requestText"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "Web push notifications log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "sentAt": { "type": "string" },
        "sentCount": { "type": "number" }
      },
      "required": ["id", "title", "message"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global website configuration and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "siteName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "PromptPost",
      "description": "Public prompt cards collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User accounts and subscription records"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Prompt categories collection"
    },
    "/search_queries/{queryId}": {
      "schema": "SearchQuery",
      "description": "Logged search queries"
    },
    "/prompt_requests/{requestId}": {
      "schema": "PromptRequest",
      "description": "User submitted custom prompt requests"
    },
    "/push_notifications/{notificationId}": {
      "schema": "PushNotification",
      "description": "Push notification messages log"
    },
    "/settings/{settingsId}": {
      "schema": "Setting",
      "description": "Global settings documents"
    },
    "/admins/{adminId}": {
      "schema": "UserProfile",
      "description": "Admin users collection"
    }
  }
}
