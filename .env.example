# Cloudinary Configuration (Optional - for image storage)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# Gemini AI API Key
GEMINI_API_KEY=

# Razorpay Configuration (For payment processing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend Email Configuration (Optional - for email verification/notifications)
RESEND_API_KEY=

# Admin Secret Key (Optional - for admin API route protection)
ADMIN_SECRET_KEY=

# Firebase Configuration (Optional: By default, firebase-applet-config.json is automatically used)
# You only need these if you want to override Firebase credentials on external hosting like Vercel
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=